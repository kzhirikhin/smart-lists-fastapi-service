# Прямые зависимости тестов. Включает runtime-набор, потому что тесты
# импортируют приложение целиком: CI и локальная разработка ставят один этот
# файл, а production-образ — только requirements.txt.
-r requirements.in
pytest==9.0.3
pytest-asyncio==1.3.0

# Windows-only extra самого pytest. pip-compile запускается в Linux-контейнере
# и такие зависимости в вывод не включает, а без строки в файле установка под
# Windows падала бы: хеши включают hash-checking mode, в котором любая
# недостающая зависимость — ошибка.
colorama==0.4.6
